	name = Petrus Damianus Sammy Wiyadi
	email = petrus.dsw@gmail.com

# Reads use HTTPS so a fresh machine can fetch public repos (Homebrew, taps, this
# repo) before the 1Password SSH agent is set up. Pushes go over SSH. Private repos
# are read through the gh credential helper.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[rerere]
	# Reuse a conflict resolution when the same conflict comes back, which a rebase of a
	# long branch does repeatedly.
	enabled = true

[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true

[merge]
	# Shows the common ancestor inside conflict markers.
	conflictStyle = zdiff3

[pull]
	# Never create a surprise merge commit: fail when the branches diverged and choose.
	ff = only

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[diff]
	algorithm = histogram

[branch]
	sort = -committerdate

[worktree]
	guessRemote = true

[alias]
	# Refuses to overwrite commits you have not fetched. Prefer the pinned form
	# `--force-with-lease=<branch>:<expected-sha>` when rewriting a shared branch.
	pushf = push --force-with-lease --force-if-includes

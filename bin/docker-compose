#!/bin/sh
# PATH shim for legacy `docker-compose` callers (Make, CI scripts).
# Call podman-compose directly - do not exec `podman compose` here or Podman
# re-dispatches to this shim on PATH and spams the external-provider warning.
if command -v podman-compose >/dev/null 2>&1; then
  exec podman-compose "$@"
fi
if ! command -v podman >/dev/null 2>&1; then
  echo "docker-compose: podman not found (install Podman or real Docker)" >&2
  exit 127
fi
exec podman compose "$@"
